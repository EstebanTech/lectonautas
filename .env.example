# Variables de entorno globales del monorepo.
#
# Docker Compose lee este archivo (como `.env` en la raíz) automáticamente y lo
# usa para interpolar los `${...}` de docker-compose.yml. Los servicios NO
# reciben estas variables tal cual: el compose decide cuáles inyecta en cada
# contenedor y con qué nombre.
#
# Convención: las variables propias de un servicio van prefijadas con el nombre
# del servicio (USER_SERVICE_*), para que no choquen entre servicios cuando el
# monorepo crezca.
#
# Uso: copiar a `.env` en la raíz y ajustar valores.
#   cp .env.example .env

# --- Postgres -------------------------------------------------------------
# Instancia compartida del entorno local; cada servicio usa su propia BD
# ("database per service").
POSTGRES_USER=user
POSTGRES_PASSWORD=password
# Puerto publicado en el host (dentro de la red del compose siempre es 5432)
POSTGRES_PORT=5433

# --- user-service ---------------------------------------------------------
USER_SERVICE_DB=user_service
USER_SERVICE_GRPC_PORT=50051
# Solo para ejecutar el servicio FUERA de docker (`make run` / `go run`):
# apunta al Postgres publicado en el host. Dentro del compose, la URL se arma
# en docker-compose.yml apuntando al host `postgres` de la red interna.
USER_SERVICE_DATABASE_URL=postgres://user:password@localhost:5433/user_service?sslmode=disable

# --- Gateway e infraestructura -------------------------------------------
GATEWAY_HTTP_PORT=8080
GATEWAY_ADMIN_PORT=9901
RATELIMIT_PORT=8081
VALKEY_PORT=6379
