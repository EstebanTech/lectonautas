# Variables de entorno globales del monorepo.
#
# Docker Compose lee este archivo (como `.env` en la raíz) automáticamente y lo
# usa para interpolar los `${...}` de docker-compose.yml. Los servicios NO
# reciben estas variables tal cual: el compose decide cuáles inyecta en cada
# contenedor y con qué nombre.
#
# Convención: las variables propias de un servicio van prefijadas con el nombre
# del servicio (USER_SERVICE_*), para que no choquen entre servicios cuando el
# monorepo crezca.
#
# Uso: copiar a `.env` en la raíz y ajustar valores.
#   cp .env.example .env

# --- Postgres -------------------------------------------------------------
# Instancia compartida del entorno local; cada servicio usa su propia BD
# ("database per service").
POSTGRES_USER=user
POSTGRES_PASSWORD=password
# Puerto publicado en el host (dentro de la red del compose siempre es 5432)
POSTGRES_PORT=5433

# --- user-service ---------------------------------------------------------
USER_SERVICE_DB=user_service
USER_SERVICE_GRPC_PORT=50051
# Solo para ejecutar el servicio FUERA de docker (`make run` / `go run`):
# apunta al Postgres publicado en el host. Dentro del compose, la URL se arma
# en docker-compose.yml apuntando al host `postgres` de la red interna.
USER_SERVICE_DATABASE_URL=postgres://user:password@localhost:5433/user_service?sslmode=disable

# --- library-service ------------------------------------------------------
# Base propia dentro del mismo contenedor de Postgres (database per service).
LIBRARY_SERVICE_DB=library_service
LIBRARY_SERVICE_GRPC_PORT=50052
LIBRARY_SERVICE_DATABASE_URL=postgres://user:password@localhost:5433/library_service?sslmode=disable

# --- interaction-service --------------------------------------------------
# Me gusta, comentarios y calificaciones, con avisos en tiempo real por
# WebSocket. Base propia, como los demás.
INTERACTION_SERVICE_DB=interaction_service
INTERACTION_SERVICE_GRPC_PORT=50053
# Puerto HTTP aparte para el WebSocket: es otro protocolo y no se puede
# multiplexar con gRPC en el mismo listener.
INTERACTION_SERVICE_WS_PORT=8090
INTERACTION_SERVICE_DATABASE_URL=postgres://user:password@localhost:5433/interaction_service?sslmode=disable

# --- Gateway e infraestructura -------------------------------------------
GATEWAY_HTTP_PORT=8080
GATEWAY_ADMIN_PORT=9901
RATELIMIT_PORT=8081
VALKEY_PORT=6379

# --- Comunes a los tres servicios ----------------------------------------
# Secreto compartido que autentica las llamadas de servicio a servicio
# (ValidateSession y los borrados masivos de limpieza). El gateway ya corta esas
# rutas desde fuera, pero eso solo protege de quien entra por la puerta: sin
# esto, cualquier cosa dentro de la red del compose podía pedir un borrado
# masivo con un id que además es público.
#
# En local sirve cualquier cadena; fuera de local tiene que ser un valor
# generado al azar y distinto por entorno. No hay valor por defecto en el
# código a propósito: si falta, los servicios no arrancan, en vez de arrancar
# pareciendo protegidos sin estarlo.
#   openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=dev-solo-para-local-cambiar-fuera-de-aqui

# Nivel del log estructurado: debug | info | warn | error.
LOG_LEVEL=info
